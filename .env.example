# Local preview. Run node tools/setup-ai.cjs first; never paste API keys into chat.
TRACKER_AI_ENABLED=false
TRACKER_AI_HOST=127.0.0.1
TRACKER_AI_PORT=8790
TRACKER_AI_PASSWORD_HASH=
# Remote use requires HTTPS, exact Origin, and Secure cookies.
TRACKER_AI_ALLOWED_ORIGIN=http://127.0.0.1:8790
TRACKER_AI_COOKIE_SECURE=false
# Optional snapshot path, private history path and Python executable:
TRACKER_AI_DATA_FILE=
TRACKER_AI_JOBS_DIR=
TRACKER_AI_PYTHON=python
# Read current model availability and confirm that billing is OFF in the provider project.
STRICT_FREE_MODE=true
ALLOW_PAID_API=false
ALLOW_AUTOTRADING=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FREE_TIER_CONFIRMED=false
GROQ_API_KEY=
GROQ_MODEL=
GROQ_FREE_TIER_CONFIRMED=false
AI_MAX_DAILY_CALLS=30
AI_MAX_DAILY_TOKENS=60000
# Internal estimates are not the provider's actual remaining quota.
# Vnstock must be initialized by the user under its current terms.
