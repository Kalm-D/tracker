# Server only. Replace hostname and set a private owner hash; never commit a real file.
TRACKER_AI_ENABLED=true
TRACKER_AI_HOST=127.0.0.1
TRACKER_AI_PORT=8790
TRACKER_AI_ALLOWED_ORIGIN=https://tracker-ai.example.com
TRACKER_AI_COOKIE_SECURE=true
TRACKER_AI_PASSWORD_HASH=
TRACKER_AI_JOBS_DIR=/var/lib/tracker-ai
TRACKER_AI_DATA_FILE=/opt/tracker-ai/public/data/market.json.gz
STRICT_FREE_MODE=true
ALLOW_PAID_API=false
ALLOW_AUTOTRADING=false
AI_MAX_DAILY_CALLS=30
AI_MAX_DAILY_TOKENS=60000
AI_MAX_RETRIES=0
AI_MAX_RSS_MIB=1024
AI_MAX_STATE_MIB=256
# Set provider credentials separately after checking free-tier/billing.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FREE_TIER_CONFIRMED=false
GROQ_API_KEY=
GROQ_MODEL=
GROQ_FREE_TIER_CONFIRMED=false
